# Copy to .env and fill in your own configuration.
DATABASE_URL=postgresql://smartlock_user:YOUR_DATABASE_PASSWORD@localhost:5432/smartlock_db
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_TIMEZONE=Asia/Jakarta
GOOGLE_CLIENT_ID=
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=true
